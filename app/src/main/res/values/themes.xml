<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="CustomDatePickerTheme" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/main_app_color</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/main_app_color</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:padding">16dp</item>
        <item name="android:headerBackground">@color/main_app_color</item>
        <!-- Add these for better compatibility -->
        <item name="android:buttonBarPositiveButtonStyle">@style/DatePickerButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DatePickerButtonStyle</item>
    </style>

    <style name="DatePickerButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/main_app_color</item>
    </style>

    <style name="CustomDatePickerStyle" parent="android:Widget.Material.DatePicker">
        <item name="android:headerBackground">@color/main_app_color</item>
        <!-- Add padding to prevent cutting off -->
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="Theme.TaskManager" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:windowBackground">@color/background_color</item>
        <item name="colorSurface">@color/background_color</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowSharedElementsUseOverlay">true</item>
    </style>
    <style name="Theme.TaskManager.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/light_gray</item>
        <item name="postSplashScreenTheme">@style/Theme.TaskManager</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenBackground">@color/background_color</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:windowSharedElementsUseOverlay">true</item>
    </style>
</resources>